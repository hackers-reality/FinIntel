# Frontend
VITE_API_BASE_URL=http://localhost:8008

# Backend
FININTEL_ENV=development
FININTEL_TIMEZONE=Asia/Kolkata
FININTEL_DB_PATH=./finintel.db
FININTEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FININTEL_APP_SECRET=replace_me_with_a_long_random_secret
FININTEL_RATE_LIMIT=60/minute
FININTEL_SESSION_TTL_MINUTES=480
FININTEL_ENABLE_BROKER_READONLY=false

# Optional provider keys supplied through environment or external secret management
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
# Do not use interactive broker credentials in FinIntel. These remain intentionally unsupported.
ZERODHA_API_SECRET=
ZERODHA_REQUEST_TOKEN=
